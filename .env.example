# Copy to .env and fill in. .env is gitignored; never commit real values.

# Secret for signing JWTs. Generate one with:
#   docker-compose run --rm backend bin/rails secret   (or: openssl rand -hex 64)
JWT_SECRET_KEY=replace-me

# Dev database in the `db` compose service (credentials match docker-compose.yml).
DATABASE_URL=postgres://postgres:postgres@db:5432/mapstash_development

# Google Maps JavaScript API key. The app boots without it, but the map won't render.
VITE_GOOGLE_MAPS_API_KEY=
